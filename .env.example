# supagloo-nodejs-dbos local-dev env (matches the root Docker Compose stack).
#
# The DBOS worker needs TWO Postgres connection strings against the single
# postgres:17 container's two logical databases (root pg-init creates both):
#
#   DATABASE_URL       : the APP db (`supagloo`). Workflows write domain rows here
#                        via db-lib's Prisma client.
#   DBOS_DATABASE_URL  : the DBOS SYSTEM db (`supagloo_dbos`). DBOS checkpoints +
#                        queues; DBOS creates its own tables here on launch.
#
# From the HOST use `localhost`; from inside the Compose network use host `postgres`.
DATABASE_URL=postgres://supagloo:supagloo@localhost:5432/supagloo
DBOS_DATABASE_URL=postgres://supagloo:supagloo@localhost:5432/supagloo_dbos

# OPTIONAL. The SCHEMA inside DBOS_DATABASE_URL's database that holds those checkpoint +
# queue tables (the SDK's `systemDatabaseSchemaName`). Its default is `dbos`.
#
# LEAVE THIS UNSET. It is not a knob to tune: it exists for the designed single-database
# deployment shape, where a platform exposes only ONE Postgres database and DBOS's
# schema-level isolation inside that database stands in for the two-logical-database
# topology. No Compose file sets it, and the SDK default is the shipped configuration.
#
# IF YOU DO SET IT, SET IT ON BOTH SERVICES TO THE SAME VALUE. This worker and the
# `supagloo-nodejs-api` service must agree: a schema configured on one service only leaves
# the API enqueueing into a namespace that nothing polls — jobs are accepted, persisted,
# and then sit queued forever, with no error anywhere saying why.
#
# MACHINE-ENFORCED since 2026-07-26, so you do not have to take this paragraph on trust.
# The root repo's `tests/unit/compose-config.test.ts` carries "PART V invariant 6": every
# compose file must set this on BOTH api and dbos or on neither, the MERGED stack must
# resolve it to the same value on both, and it must be unset everywhere today. The root's
# `tests/unit/compose-test-overlay.test.ts` separately forbids the test overlay from
# setting it on any service — a lane schema belongs at a spec's call site, never in a
# compose file where it would repartition a developer's stack behind their back.
#
# (The e2e suites also use per-lane schemas, but they pass the value EXPLICITLY at the
# call site and never read this variable, so nothing here affects a test run.)
# DBOS_SYSTEM_DATABASE_SCHEMA=

# development | test | production (default: development)
NODE_ENV=development

# --- GitHub App + git-ops (Task #17, design-delta §2.3/§7) ---
# Required (fail-fast at boot). App-LEVEL secrets/config — one pair per app
# registration, shared by the API and DBOS, NOT per-user. The git-ops workflows sign
# short-lived App JWTs to mint installation tokens. The private key is the app's
# PKCS#1/PKCS#8 PEM (a single-line value with escaped \n is accepted; db-lib's
# normalizePemNewlines restores the real newlines before signing).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# GitHub REST API host (installation tokens, repo reachability, PRs) and the git
# clone/push host. They default to the REAL hosts and are now NEVER overridden: task 62
# deleted the github-stub + git-server, so every dbos e2e reaches real github.com /
# api.github.com and these defaults are the only source (`providers.e2e.ts`'s no-stub
# guard asserts exactly that). GITHUB_GIT_BASE_URL is dbos-only — dbos is the only git
# client; the API never clones.
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_GIT_BASE_URL=https://github.com

# --- Real-GitHub e2e credentials (task 62) ---
# The git-ops e2e lanes (scaffold / commit / publish / import / render) create per-run
# THROWAWAY repos (named with the shared e2e prefix + a per-run id — the prefix itself
# lives in exactly ONE authored file, root `tests/support/e2e-github-naming.mjs`) and
# scaffold them for real. They read these from the UNTRACKED ROOT `.env`, which
# `tests/e2e/load-root-env.ts` loads into each vitest worker — so normally you set them
# ONCE, there, not here. Names + docs only; never values, in any tracked file.
#
#   GITHUB_APP_SLUG        the App's slug (`supagloo`) — used in fail-fast remediation text
#                          pointing at https://github.com/apps/<slug>/installations/new
#   GITHUB_E2E_PAT_TOKEN   a CLASSIC PAT (`repo` + `delete_repo`). Required because the
#                          installation grants contents/pull_requests/metadata and NO
#                          `administration`, so an installation token cannot create a repo.
#                          HOST-SIDE ONLY — it must never enter a container or a render
#                          child process.
#   SUPAGLOO_E2E_GITHUB_OWNER  OPTIONAL. Pins the target account when the App has more
#                          than one installation. With exactly one, it is discovered.
#   SUPAGLOO_ROOT_DIR      OPTIONAL. Where the ROOT `supagloo` checkout lives. It resolves
#                          to a sibling of this repo by default; `tests/e2e/load-root-env.ts`
#                          reads the root `.env` from there and `src/testing/github-e2e.ts`
#                          dynamic-imports the SHARED harness from
#                          <root>/tests/support/e2e-github-naming.mjs + e2e-github-api.mjs.
#                          Set it only if the root repo is somewhere else — the adapter's
#                          "root harness not found" error names this variable, so it has to
#                          be documented here. (Same var, same meaning, in api and nextjs.)
#
# The installation id is DISCOVERED at runtime (GET /app/installations) — never
# configured, never hardcoded. Nothing here is torn down automatically: reclaim the
# throwaway repos with root's interactive `npm run cleanup:github-e2e`, which ARCHIVES
# (never deletes) and confirms each repo name.

OPENROUTER_BASE_URL=https://openrouter.ai
GLOO_BASE_URL=https://platform.ai.gloo.com
YOUVERSION_BASE_URL=https://api.youversion.com

# --- E2E provider secrets (design-delta §10.8, task 34-E2) ---
# The real-provider gating e2e suites hit the LIVE OpenRouter / Gloo / YouVersion
# APIs. The vars below are REQUIRED: a missing one must FAIL the e2e global-setup fast
# with an actionable message (34-E8) — a suite that silently skips provider tests is a
# green lie. Only YOUVERSION_E2E_ACCESS_TOKEN is deliberately optional. These are
# e2e-SETUP secrets; the fabricated-ciphertext seeding they replace is 34-E4's rework.
# CI wiring is out of scope (§9-Q12).

# YouVersion Platform API key (already wired — also the app's optional userinfo header).
YOUVERSION_APP_KEY=

# Real, live-verifiable Gloo AI client credentials. dbos-e2e live-mints a Gloo token
# (mintGlooToken) and fails setup if it fails, only then writing the encrypted row.
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=

# A DEDICATED, LOW-BALANCE OpenRouter key (design-delta §10.3/§10.9) — the low cap is
# the backstop against a runaway media-generation suite. Never reuse a production key.
OPENROUTER_E2E_TEST_API_KEY=

# Optional (the ONE deliberately-optional real spec, design-delta §10.4b): a dedicated
# test account's YouVersion access token for the live round-trip. When unset, that spec
# skips LOUDLY (never silently). The vars above do NOT skip.
YOUVERSION_E2E_ACCESS_TOKEN=

# NOT per-user data — one key per deployment, shared by the API and DBOS.
SECRETS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Task #36 renderWorkflow (design-delta §7 workflow 9). ALL OPTIONAL.
#
# The three timeouts are CHILD-PROCESS kill deadlines (DBOS has no per-step timeout),
# standing in for the design's "generous renderMedia step timeout". The schema defaults
# are 3600/900/900 seconds — deliberately generous; real sizing/timeout tuning is the
# load-testing task 45 (§9-Q8), which is why they are env-tunable at all.
RENDER_MEDIA_TIMEOUT_SECONDS=
RENDER_BUNDLE_TIMEOUT_SECONDS=
RENDER_INSTALL_TIMEOUT_SECONDS=
# How often a long render/still step polls its own DBOS status so a cancelWorkflow can
# COOPERATIVELY abort Chromium (DBOS's own cancel only preempts at the NEXT step boundary).
RENDER_CANCEL_POLL_SECONDS=

# FALLBACK audio models for a render whose manifest carries no cached narration/music
# asset ref. No default on purpose: model ids are never hardcoded (§10.9), and UNSET means
# the render proceeds WITHOUT that track rather than failing. The normal path is that the
# studio (task 35) already generated and committed the refs. The render e2e resolves these
# from live OpenRouter discovery rather than reading them from here.
RENDER_NARRATION_MODEL=
RENDER_MUSIC_MODEL=
